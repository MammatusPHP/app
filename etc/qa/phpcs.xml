<?xml version="1.0"?>
<ruleset>
    <arg name="basepath" value="../../" />
    <arg name="extensions" value="php" /> <!-- which extensions to look for -->
    <arg name="colors" />
    <arg name="cache" value="../../var/.phpcs.cache" /> <!-- cache the results and don't commit them -->
    <arg value="np" /> <!-- n = ignore warnings, p = show progress -->

    <file>../config</file>
    <file>../di</file>
    <file>../../etc</file>
    <file>../../src</file>
    <file>../../tests</file>
    <file>../dev-app</file>

    <rule ref="WyriHaximus-OSS" />

    <exclude name="Generic.NamingConventions.ConstructorName"/>

    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>src/Generated/MammatusGeneratedCompiledContainer\.php$</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <exclude-pattern>src/Generated/MammatusGeneratedCompiledContainer\.php$</exclude-pattern>
    </rule>
</ruleset>
